# Modelo do /srv/typebot/.env (docs/11-typebot.md, passo 4). Variaveis conferidas em docs.typebot.com/self-hosting/configuration
# em 14/11/2026. Os segredos sao gerados no servidor pelo passo 4: nao preencher a mao, nao commitar.

# Banco proprio do Typebot (container typebot-db). A mesma senha nas duas linhas.
TYPEBOT_DB_PASSWORD=GERADO_NO_SERVIDOR
DATABASE_URL=postgresql://postgres:GERADO_NO_SERVIDOR@typebot-db:5432/typebot

# Chave de 32 caracteres que cifra os dados sensiveis. A mesma no editor e no executor (este arquivo e dos dois).
ENCRYPTION_SECRET=GERADO_NO_SERVIDOR

NEXTAUTH_URL=https://typebot.embalagemcanoinhas.com.br
NEXT_PUBLIC_VIEWER_URL=https://bot.embalagemcanoinhas.com.br

# Quem entra no editor. Login por link no e-mail (precisa do SMTP abaixo).
ADMIN_EMAIL=SEU_EMAIL
# Depois do primeiro login, trocar para true e reiniciar (passo 8).
DISABLE_SIGNUP=false

# SMTP: a mesma caixa que a loja usa para enviar (SMTP_USER/SMTP_PASS/MAIL_FROM do .env da loja).
SMTP_HOST=mail.portalplanaltonorte.com.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=COPIADO_DO_ENV_DA_LOJA
SMTP_PASSWORD=COPIADO_DO_ENV_DA_LOJA
NEXT_PUBLIC_SMTP_FROM=COPIADO_DO_ENV_DA_LOJA
