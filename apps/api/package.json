{
  "name": "@loja/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "create-owner": "tsx --env-file=../../.env src/db/create-owner.ts",
    "demo": "tsx --env-file=../../.env src/db/demo.ts",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^11.2.2",
    "argon2": "^0.45.2",
    "fast-xml-parser": "5.12.1",
    "fastify": "^5.12.8",
    "nodemailer": "10.2.1",
    "otplib": "^13.6.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
